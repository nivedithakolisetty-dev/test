# ==============================================================
# GEMINI CHATBOX - BACKEND ENVIRONMENT VARIABLES
# ==============================================================

# Server Port
PORT=5000

# Google Gemini API Key
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ==============================================================
# SUPABASE CONFIGURATION
# Obtain credentials from: https://supabase.com/dashboard/project/_/settings/api
# ==============================================================

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for public clients / JWT verification)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (secret! Used for backend admin operations bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
