# ==============================================================
# GITIGNORE - GEMINI LLM CHATBOX & SUPABASE
# ==============================================================

# --------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# --------------------------------------------------------------
# Ignore all .env files containing API keys and private tokens
.env
.env.*
*.env
backend/.env
frontend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# DO NOT ignore example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Private keys, certificates, credentials
*.pem
*.key
*.cert
*.crt
credentials.json
serviceAccountKey.json

# --------------------------------------------------------------
# 2. DEPENDENCIES & PACKAGE MANAGERS
# --------------------------------------------------------------
node_modules/
*/node_modules/
backend/node_modules/
.pnp
.pnp.js

# --------------------------------------------------------------
# 3. LOGS & DEBUG FILES
# --------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------------------
# 4. OPERATING SYSTEM & EDITOR ARTIFACTS
# --------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# IDE Workspace Internals
argv.json
extensions/

# --------------------------------------------------------------
# 5. BUILD OUTPUTS & CACHES
# --------------------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
tmp/
temp/
scratch/
.system_generated/
.gemini/
